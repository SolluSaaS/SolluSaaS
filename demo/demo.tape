Output demo/nmk.gif

Require gum

Set Shell "bash"
Set FontSize 20
Set FontFamily "DejaVu Sans Mono"
Set Width 1100
Set Height 720
Set Padding 30
Set Margin 0
Set WindowBar Colorful
Set WindowBarSize 40
Set BorderRadius 12
Set TypingSpeed 55ms
Set Theme { "name": "Zion", "black": "#0d1117", "red": "#ff7b72", "green": "#3fb950", "yellow": "#d29922", "blue": "#79c0ff", "magenta": "#d2a8ff", "cyan": "#79c0ff", "white": "#e6edf3", "brightBlack": "#6e7681", "brightRed": "#ffa198", "brightGreen": "#56d364", "brightYellow": "#e3b341", "brightBlue": "#a5d6ff", "brightMagenta": "#e2c5ff", "brightCyan": "#a5d6ff", "brightWhite": "#ffffff", "background": "#0d1117", "foreground": "#c9d1d9", "selection": "#1c3324", "cursor": "#3fb950" }

Hide
Type "export PS1='\[\e[38;2;121;192;255m\]nunes@nmk\[\e[0m\]:\[\e[38;2;210;168;255m\]~\[\e[0m\]$ ' && export PATH=$PWD/demo:$PATH && clear"
Enter
Show

Sleep 600ms
Type "nmk"
Sleep 400ms
Enter
Sleep 2200ms

# escolhe o problema
Down
Sleep 350ms
Down
Sleep 350ms
Down
Sleep 700ms
Enter
Sleep 7800ms

# a pílula vermelha
Sleep 900ms
Down
Sleep 900ms
Enter
Sleep 4500ms
